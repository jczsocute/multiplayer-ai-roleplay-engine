# OpenAI or another OpenAI-compatible API
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
WORLD_UPDATE_MAX_TOKENS=8192
NARRATION_MAX_TOKENS=4096

# Web page and Public WebSocket (/ws). Use 0.0.0.0 for LAN access.
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Host management is deliberately a separate loopback-only listener.
HOST_WS_HOST=127.0.0.1
HOST_WS_PORT=8766

# Shared entry key for the public endpoint. Leave empty to auto-generate one
# at startup (it will be printed in the server log).
ROOM_KEY=

# How long a disconnected user keeps nickname/role before being removed.
DISCONNECT_GRACE_SECONDS=60

# Web UI font scale (0.4 - 1.5). 0.8 makes a compact phone-friendly layout.
UI_FONT_SCALE=0.8
