# OpenAI or another OpenAI-compatible API
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
WORLD_UPDATE_MAX_TOKENS=8192
NARRATION_MAX_TOKENS=4096

# Narrator context window: the most recent N completed rounds (whole rounds only).
# Display history (Web role_view) stays complete and ignores this limit.
NARRATOR_HISTORY_ROUNDS=20

# Web page and Public WebSocket (/ws). Use 0.0.0.0 for LAN access.
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Deployment limits only; the core runtime accepts any validated role count.
MIN_ROLE_COUNT=2
MAX_ROLE_COUNT=4

# Legacy single-game shared entry key (deprecated --game mode only). Platform
# Rooms use room_code and an optional room_password instead.
ROOM_KEY=

# Legacy single-game mode: how long a disconnected user keeps its slot.
DISCONNECT_GRACE_SECONDS=60

# Platform Rooms: seats per Room (owner + players + spectators + grace seats).
MAX_ROOM_USERS=10
# How long a Room membership survives losing the Room connection. On expiry an
# ordinary member leaves the Room; the owner's Room closes (the save is kept).
ROOM_DISCONNECT_TIMEOUT_SECONDS=300

# Web UI font scale (0.4 - 1.5). 0.8 makes a compact phone-friendly layout.
UI_FONT_SCALE=0.8

# Platform: accounts, Template/Game/Room metadata and Multi-room Runtime catalog.
PLATFORM_DB=data/platform.db
# One-time compatibility source. If platform.db is new and this file exists,
# users and auth_sessions are copied; the old file is retained.
ACCOUNTS_DB=data/accounts.db
ALLOW_REGISTRATION=true
AUTH_SESSION_DAYS=30
# Set true only when serving over HTTPS.
AUTH_COOKIE_SECURE=false

# Browser WebSocket Origin allow-list (comma separated). Leave empty to accept
# same-host browsers plus localhost/127.0.0.1; non-browser clients (the local
# Admin console) send no Origin and are always accepted.
# Example for a Cloudflare Tunnel: ALLOWED_ORIGINS=https://rp.example.com
ALLOWED_ORIGINS=
